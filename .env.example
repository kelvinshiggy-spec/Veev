# ─────────────────────────────────────────────────────────────
# VEEV environment variables
# Copy to .env.local for local development, or set these in your host (e.g. Vercel).
# Nothing here is ever sent to the browser except variables starting with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Claude API key for Clarity (server-side only). Get one at https://console.anthropic.com
# Without it, Clarity shows an honest "not connected" state and every other feature works.
ANTHROPIC_API_KEY=

# Protects the AI route so strangers can't spend your API credits.
# Use ONE of these:
#  a) Supabase sign-in (set the two NEXT_PUBLIC_SUPABASE_* values below), optionally limited to
#     specific emails with VEEV_ALLOWED_EMAILS, or
#  b) a private access code that Veev enters once in Me → Privacy & data.
# In production, Clarity refuses to run until one of these is set.
VEEV_ACCESS_CODE=
VEEV_ALLOWED_EMAILS=

# Optional: encrypted cloud backup + sign-in (Supabase). Run supabase/schema.sql first.
# The anon key is safe to expose; Row Level Security restricts every row to its owner.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
